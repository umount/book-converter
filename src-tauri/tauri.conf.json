{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "book-converter",
  "version": "0.1.0",
  "identifier": "com.sobolev.book-converter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run tts:bundle && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Book Converter",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "pdfium/": "pdfium/",
      "tts-runtime/": "tts-runtime/",
      "../third-party/": "third-party/",
      "../LICENSE.md": "LICENSE.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
